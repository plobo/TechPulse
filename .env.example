# Backend configuration ONLY. Never put AI provider keys or other secrets in the iOS app.
# The iOS app reads only the public base URL below (via scheme environment or Info.plist).

# Public HTTPS base URL of the TechPulse content API. Leave unset to use bundled sample data.
TECHPULSE_API_BASE_URL=https://api.example.com

# --- Backend service (not read by the app) ---
# AI_PROVIDER=
# AI_PROVIDER_API_KEY=
# DATABASE_URL=
